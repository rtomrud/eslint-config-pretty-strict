{
  "name": "eslint-config-pretty-strict",
  "version": "10.0.0",
  "description": "A strict ESLint config",
  "keywords": [
    "config",
    "eslint",
    "hint",
    "lint",
    "style"
  ],
  "homepage": "https://github.com/rtomrud/eslint-config-pretty-strict#readme",
  "bugs": {
    "url": "https://github.com/rtomrud/eslint-config-pretty-strict/issues"
  },
  "license": "MIT",
  "author": "Artem Rudenko <rtomrud@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rtomrud/eslint-config-pretty-strict.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "prepare": "vp config"
  },
  "dependencies": {
    "@eslint/js": "^9.39.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "eslint": "^9.39.5",
    "typescript": "^7.0.2",
    "vite-plus": "^1.6.0"
  },
  "peerDependencies": {
    "eslint": ">=8.57.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.2.2",
      "onFail": "download"
    }
  }
}
